# Public origin of the site, used for canonical URLs, the sitemap, robots.txt,
# llms.txt and structured data. Falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://example.com

# The Car's Secrets API (../cars-secrets-api). Server-only: never prefix with NEXT_PUBLIC_.
API_URL=http://localhost:8000
# Same value as INTERNAL_API_KEY in the API's .env. Lets the API trust the visitor
# address the web server forwards for rate limiting. Secret.
API_INTERNAL_KEY=

# Cloudflare Turnstile site key (public). Empty = no captcha widget; the API then
# must not require one either (leave TURNSTILE_SECRET empty there too).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
